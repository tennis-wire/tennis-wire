{
    "realm": "tennis-wire",
    "displayName": "Tennis Wire",
    "enabled": true,
    "sslRequired": "external",
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "registrationAllowed": false,
    "resetPasswordAllowed": true,
    "verifyEmail": false,

    "accessTokenLifespan": 300,
    "ssoSessionIdleTimeout": 1800,
    "ssoSessionMaxLifespan": 28800,

    "clients": [
        {
            "clientId": "editorial-ui",
            "name": "Editorial UI",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": ["http://localhost:5173/*"],
            "webOrigins": ["http://localhost:5173"],
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "http://localhost:5173/*"
            },
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "public-web",
            "name": "Public Web (SSR)",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-public-web-secret",
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": ["http://localhost:3000/api/auth/callback/*"],
            "webOrigins": ["http://localhost:3000"],
            "attributes": {
                "post.logout.redirect.uris": "http://localhost:3000/*"
            },
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "mobile",
            "name": "Mobile (Expo)",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": ["tenniswire://*", "exp://127.0.0.1:8081/*"],
            "webOrigins": [],
            "attributes": {
                "pkce.code.challenge.method": "S256"
            },
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "moderation-bot",
            "name": "Moderation Bot",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-moderation-bot-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "dev-cli",
            "name": "Password grant for local curl and tests",
            "description": "Local artefact. The production realm must not contain this client.",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": false,
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        }
    ],

    "users": [
        {
            "username": "dev",
            "enabled": true,
            "emailVerified": true,
            "email": "dev@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Staff",
            "credentials": [{ "type": "password", "value": "dev", "temporary": false }],
            "realmRoles": ["author", "admin"]
        },
        {
            "username": "reader",
            "enabled": true,
            "emailVerified": true,
            "email": "reader@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Reader",
            "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
            "realmRoles": ["user"]
        },
        {
            "username": "service-account-moderation-bot",
            "enabled": true,
            "serviceAccountClientId": "moderation-bot",
            "realmRoles": ["moderator-bot"]
        }
    ],

    "roles": {
        "realm": [
            { "name": "user", "description": "Registered reader: comments, fantasy, own profile" },
            { "name": "author", "description": "Staff: editorial contour" },
            { "name": "moderator", "description": "Staff: comment moderation" },
            { "name": "moderator-bot", "description": "Service account of the automatic moderator" },
            {
                "name": "admin",
                "description": "Administrator",
                "composite": true,
                "composites": { "realm": ["user", "author", "moderator"] }
            }
        ]
    }
}
