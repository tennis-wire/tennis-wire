{
    "realm": "tennis-wire",
    "displayName": "Tennis Wire",
    "enabled": true,
    "sslRequired": "external",
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "registrationAllowed": true,
    "registrationEmailAsUsername": true,
    "resetPasswordAllowed": true,
    "verifyEmail": true,

    "loginTheme": "tennis-wire",
    "internationalizationEnabled": true,
    "supportedLocales": ["ru", "en"],
    "defaultLocale": "ru",

    "accessTokenLifespan": 300,
    "ssoSessionIdleTimeout": 1800,
    "ssoSessionMaxLifespan": 28800,

    "offlineSessionIdleTimeout": 2592000,
    "offlineSessionMaxLifespanEnabled": true,
    "offlineSessionMaxLifespan": 15552000,

    "eventsEnabled": true,
    "eventsExpiration": 2592000,
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": false,
    "attributes": {
        "adminEventsExpiration": "7776000"
    },

    "bruteForceProtected": true,

    "smtpServer": {
        "host": "mailpit",
        "port": "1025",
        "from": "no-reply@tennis-wire.local",
        "fromDisplayName": "Tennis Wire",
        "auth": "false",
        "ssl": "false",
        "starttls": "false"
    },

    "groups": [
        {
            "name": "readers",
            "path": "/readers",
            "realmRoles": ["user"]
        }
    ],
    "defaultGroups": ["/readers"],

    "identityProviders": [
        {
            "alias": "google",
            "providerId": "google",
            "enabled": true,
            "trustEmail": true,
            "config": {
                "clientId": "${GOOGLE_CLIENT_ID}",
                "clientSecret": "${GOOGLE_CLIENT_SECRET}",
                "syncMode": "IMPORT"
            }
        }
    ],

    "clients": [
        {
            "clientId": "editorial-ui",
            "name": "Editorial UI",
            "baseUrl": "http://localhost:5173",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": [
                "http://localhost:5173/auth/callback",
                "http://localhost:5173/popup-callback.html"
            ],
            "webOrigins": ["http://localhost:5173"],
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"],
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "http://localhost:5173/logged-out"
            },
            "protocolMappers": [
                {
                    "name": "realm-roles-in-id-token",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "claim.name": "realm_access.roles",
                        "jsonType.label": "String",
                        "multivalued": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "false",
                        "introspection.token.claim": "false",
                        "userinfo.token.claim": "false"
                    }
                },
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "public-web",
            "name": "Public Web (SSR)",
            "baseUrl": "http://localhost:3000",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-public-web-secret",
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
            "webOrigins": ["http://localhost:3000"],
            "fullScopeAllowed": false,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "offline_access", "organization", "phone"],
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "post.logout.redirect.uris": "http://localhost:3000/*"
            },
            "protocolMappers": [
                {
                    "name": "realm-roles-in-id-token",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "claim.name": "realm_access.roles",
                        "jsonType.label": "String",
                        "multivalued": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "false",
                        "introspection.token.claim": "false",
                        "userinfo.token.claim": "false"
                    }
                },
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "mobile",
            "name": "Mobile (Expo)",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": ["tenniswire://*", "exp://127.0.0.1:8081/*"],
            "webOrigins": [],
            "fullScopeAllowed": false,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "offline_access", "organization", "phone"],
            "attributes": {
                "pkce.code.challenge.method": "S256"
            },
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "user-service",
            "name": "User Service",
            "description": "Service account for calls into /internal/** and the Keycloak admin REST API (account deletion, realm token lifespan).",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-user-service-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"],
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "discussion-service",
            "name": "Discussion Service",
            "description": "Service account for calls into user-service /internal/users.",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-discussion-service-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"],
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "moderation-bot",
            "name": "Moderation Bot",
            "enabled": true,
            "publicClient": false,
            "secret": "dev-moderation-bot-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"],
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "no-audience",
            "name": "Client without the api audience mapper",
            "description": "Local artefact. Issues tokens that must NOT be accepted by our services; exists so that aud validation is covered by a test rather than assumed.",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": false,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"]
        },
        {
            "clientId": "dev-cli",
            "name": "Password grant for local curl and tests",
            "description": "Local artefact. The production realm must not contain this client.",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": false,
            "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
            "optionalClientScopes": ["address", "microprofile-jwt", "organization", "phone"],
            "protocolMappers": [
                {
                    "name": "tennis-wire-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.custom.audience": "tennis-wire-api",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        }
    ],

    "users": [
        {
            "username": "dev",
            "enabled": true,
            "emailVerified": true,
            "email": "dev@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Staff",
            "credentials": [{ "type": "password", "value": "dev", "temporary": false }],
            "realmRoles": ["author", "admin", "offline_access"]
        },
        {
            "username": "reader",
            "enabled": true,
            "emailVerified": true,
            "email": "reader@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Reader",
            "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
            "realmRoles": ["user", "offline_access"]
        },
        {
            "username": "moderator",
            "enabled": true,
            "emailVerified": true,
            "email": "moderator@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Moderator",
            "credentials": [{ "type": "password", "value": "moderator", "temporary": false }],
            "realmRoles": ["moderator", "user", "offline_access"]
        },
        {
            "username": "author",
            "enabled": true,
            "emailVerified": true,
            "email": "author@tennis-wire.local",
            "firstName": "Dev",
            "lastName": "Author",
            "credentials": [{ "type": "password", "value": "author", "temporary": false }],
            "realmRoles": ["author", "user", "offline_access"]
        },
        {
            "username": "service-account-moderation-bot",
            "enabled": true,
            "serviceAccountClientId": "moderation-bot",
            "realmRoles": ["moderator-bot"]
        },
        {
            "username": "service-account-user-service",
            "enabled": true,
            "serviceAccountClientId": "user-service",
            "realmRoles": ["service"],
            "clientRoles": {
                "realm-management": ["manage-users", "view-realm"]
            }
        },
        {
            "username": "service-account-discussion-service",
            "enabled": true,
            "serviceAccountClientId": "discussion-service",
            "realmRoles": ["service"]
        }
    ],

    "scopeMappings": [
        { "client": "public-web", "roles": ["user", "author"] },
        { "client": "mobile", "roles": ["user"] }
    ],

    "roles": {
        "realm": [
            { "name": "user", "description": "Registered reader: comments, fantasy, own profile" },
            { "name": "author", "description": "Staff: editorial contour" },
            {
                "name": "chief-editor",
                "description": "Staff: author plus others' published content",
                "composite": true,
                "composites": { "realm": ["author"] }
            },
            { "name": "moderator", "description": "Staff: comment moderation" },
            { "name": "moderator-bot", "description": "Service account of the automatic moderator" },
            { "name": "service", "description": "Service account: calls into /internal/**" },
            {
                "name": "admin",
                "description": "Administrator",
                "composite": true,
                "composites": { "realm": ["user", "author", "moderator", "chief-editor"] }
            }
        ]
    }
}
