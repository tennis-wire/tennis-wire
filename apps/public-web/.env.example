# Copy to .env.local and fill in. Next loads .env.local automatically; it is
# git-ignored, .env.example is not.

APP_ORIGIN=http://localhost:3000

# The realm, not the server: openid-client discovers the endpoints from here.
KEYCLOAK_ISSUER=http://localhost:8180/realms/tennis-wire
KEYCLOAK_CLIENT_ID=public-web
# Local-only value from the realm file. A deployment overrides it.
KEYCLOAK_CLIENT_SECRET=dev-public-web-secret

# Encrypts the session cookie. At least 32 characters; `openssl rand -base64 32`.
# Changing it signs everyone out.
SESSION_PASSWORD=
