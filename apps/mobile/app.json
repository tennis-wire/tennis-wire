{
    "expo": {
        "name": "Tennis Wire",
        "slug": "tennis-wire",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "scheme": "tenniswire",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.tenniswire.app"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "package": "com.tenniswire.app"
        },
        "plugins": [
            "expo-router",
            "expo-font",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#1B6B3A"
                }
            ],
            "expo-status-bar"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
