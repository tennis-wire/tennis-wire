# expo-router depends on react-native-drawer-layout, which declares reanimated
# and gesture-handler as hard peers. Navigation here is Tabs + Stack only, so
# npm would install three native modules the app never imports, plus a
# react-native-worklets version outside the range expo-modules-core asks for.
# Drop this file (and reinstall) if the app starts using any of them.
legacy-peer-deps=true
