# Copy to .env.local and fill in. EXPO_PUBLIC_ vars are inlined into the app
# bundle at build time by Metro, so nothing here should be a secret (there
# is no client secret: `mobile` is a public OAuth client).
#
# `localhost` will not resolve from a device or simulator; use your machine's
# LAN IP (or 10.0.2.2 for the Android emulator) instead.

# The realm, not the server: expo-auth-session discovers the endpoints from here.
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/tennis-wire

# The gateway as this app reaches it.
EXPO_PUBLIC_GATEWAY_ORIGIN=http://localhost:8090
