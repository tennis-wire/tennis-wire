# Parsing Service Configuration
# Copy this to .env and fill in the values

# ============== APP ==============
APP_ENV=development
LOG_LEVEL=INFO

# ============== REDIS (state, arq) ==============
# Database 1: the transcription worker uses 0
REDIS_URL=redis://localhost:6379/1

# ============== SOURCES AND OUTPUT ==============
SOURCES_FILE=sources.yaml
OUTPUT_DIR=out
# The worker sends to the aggregator; files is for running it without one
SINK=aggregator

# ============== AGGREGATOR ==============
AGGREGATOR_URL=http://localhost:8095
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/tennis-wire
CLIENT_ID=parsing-service
CLIENT_SECRET=dev-parsing-service-secret

# ============== HOW SITES SEE US ==============
# Page or email in the User-Agent; filled before deployment
BOT_CONTACT=
