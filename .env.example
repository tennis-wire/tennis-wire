# Copy to .env in this directory and fill in. Read by `docker compose` only.
# .env is git-ignored: this repository is public and Google revokes client
# secrets it finds in public repositories.

# ============== Google identity provider ==============
# OAuth client of type "Web application" in the Google Auth Platform
# (Google Cloud Console -> APIs & Services -> Google Auth Platform -> Clients),
# with one authorized redirect URI:
#
#   http://localhost:8180/realms/tennis-wire/broker/google/endpoint
#
# Leave empty to run the stand without Google: everything else works, the
# Google button on the Keycloak login page does not.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
