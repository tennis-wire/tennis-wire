// Модель системы tennis-wire.
//
// Соглашение: тег #planned помечает всё, чего ещё нет в репозитории.
// Виды без суффикса Target показывают текущее состояние (as-is) и исключают
// такие элементы; виды с суффиксом Target — целевую картину (to-be).
// Если элемент существует, но связь ещё не подключена, это указано в подписи
// к связи.
//
// Auth: топология identity-провайдера, клиентов и валидации токенов — здесь;
// роли, клиенты, TTL и политика — в architecture/auth.md (источник правды),
// решение — в docs/adr/0001-identity-provider.md.

specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system {
    style {
      shape rectangle
      color slate
    }
  }
  element container {
    style {
      shape rectangle
      color blue
    }
  }
  element service {
    style {
      shape rectangle
      color indigo
    }
  }
  element database {
    style {
      shape storage
      color green
    }
  }
  element external {
    style {
      shape rectangle
      color gray
    }
  }
  element webapp {
    style {
      shape browser
      color sky
    }
  }
  element mobile {
    style {
      shape mobile
      color sky
    }
  }
  element queue {
    style {
      shape queue
      color amber
    }
  }

  tag planned
}

model {
  // ===== ACTORS =====
  actor reader 'Читатель' {
    description 'Читает новости, смотрит результаты и сетки турниров'
  }

  actor registeredUser 'Пользователь' {
    description 'Зарегистрированный читатель: комментарии, жалобы, игнор-лист, личный кабинет. Фэнтези — позже'
  }

  actor author 'Автор' {
    description 'Пишет и публикует своё, правит своё опубликованное. Черновики видит только свои'
  }

  actor chiefEditor 'Главный редактор' {
    description 'Роль chief-editor поверх author: правит и снимает с публикации чужое, сбрасывает зависшие правки. Чужих черновиков не видит'
  }

  actor moderator 'Модератор' {
    description 'Разбирает очередь жалоб и сигналов бота. Ограничения и снятие комментариев есть в API, экрана для них нет'
  }

  actor admin 'Админ' {
    description 'Сотрудники, роли и отзыв доступа — в консоли Keycloak; удаление аккаунта через поддержку. Своего интерфейса нет'
  }

  // ===== EXTERNAL SYSTEMS =====
  external tennisDataSources 'Источники данных' {
    #planned
    description 'ATP, WTA, ITF, ESPN, соцсети'

    external atpWta 'ATP/WTA/ITF' {
      #planned
      description 'Официальные источники: результаты, рейтинги, сетки'
    }

    external sportsMedia 'Спортивные медиа' {
      #planned
      description 'ESPN, Tennis.com, Eurosport и др.'
    }

    external socialMedia 'Соцсети' {
      #planned
      description 'Twitter/X, Instagram'
    }

    external telegramChannels 'Telegram-каналы' {
      #planned
      description 'Теннисные каналы и чаты'
    }
  }

  external externalApis 'Внешние API' {
    description 'Сторонние сервисы'

    external deepl 'DeepL API' {
      description 'Переводы контента'
      technology 'deepl-java'
    }

    external anthropicApi 'Anthropic API' {
      description 'Claude — помощь в редактуре, AI-чат в редакторе'
      technology 'anthropic-java'
    }

    external youtube 'YouTube' {
      description 'Источник видео для транскрипции (yt-dlp)'
    }
  }

  // ===== MAIN SYSTEM =====
  system tennisService 'Tennis News Service' {
    description 'Теннисный новостной сервис'

    // ----- PARSING SUBSYSTEM -----
    container parsingSubsystem 'Парсинг' {
      #planned
      description 'Сбор данных из внешних источников'
      technology 'Python'

      service parserOrchestrator 'Parser Orchestrator' {
        #planned
        description 'Управление парсерами, расписание, мониторинг'
        technology 'Python'
      }

      service atpParser 'ATP/WTA Parser' {
        #planned
        description 'Парсер официальных источников'
        technology 'Python, Scrapy'
      }

      service mediaParser 'Media Parser' {
        #planned
        description 'Парсер спортивных медиа'
        technology 'Python, BeautifulSoup'
      }

      service socialParser 'Social Parser' {
        #planned
        description 'Парсер соцсетей'
        technology 'Python, API clients'
      }
    }

    // ----- AGGREGATOR -----
    container aggregator 'Aggregator Service' {
      #planned
      description 'Агрегация и первичная обработка сырых данных'
      technology 'Java, Spring Boot'

      service aggregatorApi 'Aggregator API' {
        #planned
        description 'API для вкладки «Источники» в редакции и внутренних сервисов'
      }

      service deduplicator 'Deduplicator' {
        #planned
        description 'Дедупликация и нормализация данных'
      }

      database aggregatorDb 'Aggregator DB' {
        #planned
        description 'Сырые данные, статусы обработки'
        technology 'PostgreSQL / MongoDB'
      }
    }

    // ----- EDITORIAL -----
    container editorial 'Editorial UI' {
      description 'Редакторский SPA: редакция и редактор материалов, временно — очередь модерации. Все обращения к бэкенду идут через API Gateway'
      technology 'React, TypeScript, Vite, Tiptap, MUI'

      webapp deskApp 'Редакция' {
        description '/desk: свои черновики и незавершённые правки опубликованного, «Открыть по ссылке», новый материал. Вкладка «Источники» (/desk/sources) — заглушка, ждёт Aggregator. Бывший Curator UI'
      }

      webapp editorApp 'Editor UI' {
        description '/editor/:id: черновик владельца, правка опубликованного с блокировкой и сравнением с сайтом, публикация, снятие для chief-editor; AI-чат, перевод, транскрипция. Несохранённое держится в localStorage до сохранения'
      }

      webapp moderationApp 'Moderation Queue' {
        description 'Очередь жалоб и очередь аватаров на постмодерации, /moderation и /moderation/avatars за ролью moderator. Место временное, постоянное не выбрано — auth.md §11'
      }
    }

    // ----- EDITORIAL BFF -----
    container editorialBff 'Editorial BFF' {
      description 'Backend for Frontend: проксирование Anthropic и DeepL для редактора'
      technology 'Java, Spring Boot'

      service editorialBffApi 'Editorial BFF API' {
        description 'AI-чат и перевод. Транскрипция через BFF не проходит'
      }
    }

    // ----- TRANSCRIPTION SERVICE -----
    container transcriptionService 'Transcription Service' {
      description 'Асинхронная транскрипция видео/аудио: YouTube-ссылки и загруженные файлы'
      technology 'Python, FastAPI, WhisperX'

      service transcriptionApi 'Transcription API' {
        description 'Приём задач, статусы, выдача результатов'
        technology 'Python, FastAPI'
      }

      service transcriptionWorker 'Transcription Worker' {
        description 'Скачивание аудио, распознавание, word-level выравнивание, диаризация'
        technology 'Python, arq, WhisperX, yt-dlp'
      }

      queue transcriptionQueue 'Job Queue' {
        description 'Очередь задач и статусы джобов'
        technology 'Redis, arq'
      }

      database transcriptionStorage 'Media Storage' {
        description 'Загруженные файлы и JSON-результаты'
        technology 'S3 (локально — MinIO)'
      }
    }

    // ----- CONTENT SERVICE -----
    container contentService 'Content Service' {
      description 'Управление контентом: черновики, правки опубликованного, публикация, публичная выдача'
      technology 'Java, Spring Boot'

      service contentApi 'Content API' {
        description '/api/editorial/**: черновики владельца, отложенная правка опубликованного с блокировкой и версиями, публикация и снятие, теги. /api/public/**: публичная выдача. Поиск сейчас — SQL по подстроке внутри сервиса'
      }

      database contentDb 'Content DB' {
        description 'Статьи, отложенные правки опубликованного, теги, разделы'
        technology 'PostgreSQL, Liquibase'
      }
    }

    // ----- SEARCH SERVICE -----
    container searchService 'Search Service' {
      #planned
      description 'Полнотекстовый поиск по контенту'
      technology 'Elasticsearch'
    }

    // ----- USER SERVICE -----
    container userService 'User Service' {
      description 'Профили читателей. Владеет внутренним user_id и связью с Identity Provider. Аутентификации здесь нет'
      technology 'Java, Spring Boot'

      service userApi 'User API' {
        description '/api/users/me: профиль и ник, аватар, удаление своего аккаунта (вход не старше 5 минут); очередь аватаров на постмодерации для moderator; DELETE /api/users/{id} для admin; /internal/**: resolve и имена пачкой. Удаление: запрос гасит учётку, остальное доделывает фоновая джоба'
      }

      database userDb 'User DB' {
        description 'Профили с ключом аватара; identity_link (provider, sub) → user_id; аккаунты на удалении; резервации имён'
        technology 'PostgreSQL, Liquibase'
      }

      database avatarStorage 'Avatar Storage' {
        description 'Аватары, JPEG 96 и 288 px, по ключу из профиля. Публичное чтение: картинки браузер берёт отсюда, минуя сервисы'
        technology 'S3 (локально — MinIO; прод — Cloudflare R2, бакета пока нет)'
      }
    }

    // ----- IDENTITY PROVIDER -----
    container identity 'Identity Provider' {
      description 'Аутентификация, роли, токены для всех клиентов. Только identity: прикладные данные пользователя — в User Service'
      technology 'Keycloak'

      service identityOidc 'OIDC' {
        description 'Authorization Code + PKCE, offline-токены читателей, client_credentials для сервисов и бота, JWKS, Admin API. Регистрация по email и вход через Google'
      }

      database identityDb 'Identity DB' {
        description 'Realm: пользователи, роли, клиенты, сессии'
        technology 'PostgreSQL (локально — H2, без volume)'
      }
    }

    // ----- MODERATION BOT -----
    container moderationBot 'Moderation Bot' {
      #planned
      description 'Автомодерация комментариев: регулярки + LLM. Самого бота нет; клиент moderation-bot, роль и API под него есть. Способ реализации и место в топологии не определены — см. auth.md §11'
      technology 'TBD'
    }

    // ----- DISCUSSION SERVICE -----
    container discussionService 'Discussion Service' {
      description 'Обсуждения: древовидные комментарии к публикациям, игнор-лист, жалобы и очередь модерации, ограничения на комментирование (срочные и бессрочные)'
      technology 'Java, Spring Boot'

      service discussionApi 'Discussion API' {
        description 'Комментарии, ветки и жалобы читателей (/api/discussion/comments/**), игнор-лист (/api/discussion/blocks/**), модерация (/api/discussion/moderation/**), стирание следа ушедшего читателя (DELETE /internal/users/{id}). Чтение анонимно, но токен, если есть, применяется: по нему считаются игнор и ограничение зрителя'
      }

      database discussionDb 'Discussion DB' {
        description 'Комментарии (дерево на ltree), игнор-лист, ограничения, жалобы'
        technology 'PostgreSQL, Liquibase'
      }
    }

    // ----- API GATEWAY -----
    container apiGateway 'API Gateway' {
      description 'Единая точка входа для всех клиентов, включая редакторский UI. Здесь же терминируется CORS и считается rate limit (Redis; ключ — читатель, иначе адрес)'
      technology 'Spring Cloud Gateway'
    }

    // ----- CLIENT APPS -----
    container webApp 'Public Web' {
      description 'Основной сайт для читателей. Next.js работает как BFF: токены у сервера, браузер ходит только в свой origin'
      technology 'Next.js, TypeScript'

      webapp publicSite 'Public Site' {
        description 'Новости, результаты, статьи. Настоящие — страница статьи и островок комментариев, остальное на моках. Сотрудникам над статьёй — ссылка «Редактировать»'
      }

      webapp userCabinet 'User Cabinet' {
        description '/me: профиль, облик, игнор-лист, смена ника, удаление аккаунта'
      }

      service webServer 'Next.js Server' {
        description 'Серверный рендер и route handlers: вход и выход (/api/auth/**), BFF-прокси /api/discussion/** и /api/users/** с allowlist заголовков, проверкой Origin и лимитом запросов без сессии. Сессия — зашифрованная httpOnly-кука, токены в браузер не уходят'
        technology 'Next.js, openid-client, iron-session'
      }
    }

    container mobileApp 'Mobile Application' {
      description 'Мобильное приложение'
      technology 'Expo, React Native'

      mobile iosApp 'iOS App'
      mobile androidApp 'Android App'
    }

  }

  // ===== RELATIONSHIPS =====

  // --- Actors ---
  reader -> tennisService.webApp.publicSite 'Читает контент'
  registeredUser -> tennisService.webApp 'Комментирует, ведёт кабинет'
  registeredUser -> tennisService.mobileApp 'Использует сервис (входа в приложении пока нет)'
  author -> tennisService.editorial 'Пишет, публикует, правит своё'
  chiefEditor -> tennisService.editorial 'Правит и снимает с публикации чужое'
  moderator -> tennisService.editorial.moderationApp 'Разбирает жалобы и новые аватары'
  admin -> tennisService.identity 'Заводит сотрудников, роли, отзыв доступа (admin-консоль)'
  admin -> tennisService.apiGateway 'DELETE /api/users/{id}: удаление аккаунта через поддержку, без интерфейса'

  // --- External sources -> Parsers ---
  tennisDataSources.atpWta -> tennisService.parsingSubsystem.atpParser 'Данные'
  tennisDataSources.sportsMedia -> tennisService.parsingSubsystem.mediaParser 'Данные'
  tennisDataSources.socialMedia -> tennisService.parsingSubsystem.socialParser 'Данные'
  tennisDataSources.telegramChannels -> tennisService.parsingSubsystem.socialParser 'Данные'

  // --- Parsers -> Aggregator ---
  tennisService.parsingSubsystem.parserOrchestrator -> tennisService.parsingSubsystem.atpParser 'Управляет'
  tennisService.parsingSubsystem.parserOrchestrator -> tennisService.parsingSubsystem.mediaParser 'Управляет'
  tennisService.parsingSubsystem.parserOrchestrator -> tennisService.parsingSubsystem.socialParser 'Управляет'

  tennisService.parsingSubsystem.atpParser -> tennisService.aggregator.aggregatorApi 'Сырые данные'
  tennisService.parsingSubsystem.mediaParser -> tennisService.aggregator.aggregatorApi 'Сырые данные'
  tennisService.parsingSubsystem.socialParser -> tennisService.aggregator.aggregatorApi 'Сырые данные'

  // --- Aggregator internal ---
  tennisService.aggregator.aggregatorApi -> tennisService.aggregator.deduplicator 'Обработка'
  tennisService.aggregator.deduplicator -> tennisService.aggregator.aggregatorDb 'Сохранение'
  tennisService.aggregator.aggregatorApi -> tennisService.aggregator.aggregatorDb 'CRUD'

  // --- Editorial ---
  // Весь редакторский трафик идёт через gateway: apiConfig.ts знает только GATEWAY_URL.
  tennisService.editorial.editorApp -> tennisService.apiGateway 'Черновики, правки, публикация и снятие; AI-чат, перевод, транскрипция'
  tennisService.editorial.deskApp -> tennisService.editorial.editorApp 'Открыть материал, новый материал'
  tennisService.editorial.deskApp -> tennisService.apiGateway 'Свои черновики и правки, материал по slug; позже — спарсенные материалы'
  tennisService.editorial.moderationApp -> tennisService.apiGateway 'Очередь жалоб и решения (/api/discussion/moderation/reports/**); очередь аватаров, «ок» и «снять» (/api/users/moderation/avatars, /api/users/{id}/avatar)'
  tennisService.editorial.moderationApp -> tennisService.userService.avatarStorage 'Картинки из очереди, напрямую из бакета'

  // --- API Gateway -> Services ---
  tennisService.apiGateway -> tennisService.editorialBff.editorialBffApi '/api/ai/**, /api/translate/**'
  tennisService.apiGateway -> tennisService.transcriptionService.transcriptionApi '/api/transcribe/**'
  tennisService.apiGateway -> tennisService.contentService.contentApi '/api/editorial/**, /api/public/**'
  tennisService.apiGateway -> tennisService.aggregator.aggregatorApi '/api/aggregator/**'
  tennisService.apiGateway -> tennisService.searchService '/api/search/**'
  tennisService.apiGateway -> tennisService.userService.userApi '/api/users/**'
  tennisService.apiGateway -> tennisService.discussionService.discussionApi '/api/discussion/**'

  // --- Editorial BFF -> External APIs ---
  tennisService.editorialBff.editorialBffApi -> externalApis.deepl 'Переводы'
  tennisService.editorialBff.editorialBffApi -> externalApis.anthropicApi 'AI-обработка'

  // --- Transcription internal ---
  tennisService.transcriptionService.transcriptionApi -> tennisService.transcriptionService.transcriptionQueue 'Ставит задачи, читает статусы'
  tennisService.transcriptionService.transcriptionWorker -> tennisService.transcriptionService.transcriptionQueue 'Забирает задачи, пишет статусы'
  tennisService.transcriptionService.transcriptionApi -> tennisService.transcriptionService.transcriptionStorage 'Загрузки, presigned-ссылки'
  tennisService.transcriptionService.transcriptionWorker -> tennisService.transcriptionService.transcriptionStorage 'Аудио и результаты'
  tennisService.transcriptionService.transcriptionWorker -> externalApis.youtube 'Скачивает аудио'

  // --- Content Service ---
  tennisService.contentService.contentApi -> tennisService.contentService.contentDb 'CRUD'
  tennisService.contentService.contentApi -> tennisService.searchService 'Индексация'

  // --- User / Discussion internal ---
  tennisService.userService.userApi -> tennisService.userService.userDb 'Профили, identity_link, аккаунты на удалении, резервации имён'
  tennisService.userService.userApi -> tennisService.userService.avatarStorage 'Аватары: запись двух размеров; старые удаляются после коммита'
  tennisService.discussionService.discussionApi -> tennisService.discussionService.discussionDb 'CRUD'

  // Оба направления между сервисами идут напрямую по кластерному DNS, /internal/** через gateway
  // не маршрутизируется. Цикл здесь намеренный: каждая сторона владеет тем, чего у другой нет —
  // discussion спрашивает user_id читателя и имена авторов, user удаляет след ушедшего читателя (readers.md §1.6).
  tennisService.discussionService.discussionApi -> tennisService.userService.userApi 'POST /internal/identities/resolve: user_id читателя по его же токену'
  tennisService.discussionService.discussionApi -> tennisService.userService.userApi 'GET /internal/users?ids=: имена авторов пачкой'
  tennisService.userService.userApi -> tennisService.discussionService.discussionApi 'DELETE /internal/users/{id}: стирание следа, ответ несёт срок действующего бана'

  // --- Auth: клиенты -> Identity Provider ---
  // Идентификаторы клиентов и роли — auth.md §2–§3
  tennisService.editorial -> tennisService.identity.identityOidc 'OIDC Authorization Code + PKCE (client editorial-ui)'
  tennisService.webApp.webServer -> tennisService.identity.identityOidc 'OIDC Authorization Code + PKCE, confidential client public-web; обновление и отзыв offline-токена; роли из id-токена — флаг сотрудника'
  tennisService.mobileApp -> tennisService.identity.identityOidc 'OIDC Authorization Code + PKCE (client mobile; клиент в realm есть, в приложении не подключено)'
  tennisService.moderationBot -> tennisService.identity.identityOidc 'client_credentials (client moderation-bot, роль moderator-bot)'

  // --- Auth: валидация токенов по JWKS ---
  tennisService.apiGateway -> tennisService.identity.identityOidc 'JWKS: валидация JWT, роль -> маршрут'
  tennisService.contentService.contentApi -> tennisService.identity.identityOidc 'JWKS: валидация JWT'
  tennisService.editorialBff.editorialBffApi -> tennisService.identity.identityOidc 'JWKS: валидация JWT'
  tennisService.transcriptionService.transcriptionApi -> tennisService.identity.identityOidc 'JWKS: валидация JWT, owner у задач'
  tennisService.discussionService.discussionApi -> tennisService.identity.identityOidc 'JWKS: валидация JWT, на анонимных чтениях токен необязателен, но валидируется; client_credentials для /internal/** user-service'
  tennisService.userService.userApi -> tennisService.identity.identityOidc 'JWKS: валидация JWT; client_credentials для /internal/** discussion-service'
  // Роли manage-users и view-realm выданы сервисному аккаунту клиента user-service (auth.md §3)
  tennisService.userService.userApi -> tennisService.identity.identityOidc 'Admin API: гашение и удаление учётки, чтение accessTokenLifespan'

  // --- Identity internal ---
  tennisService.identity.identityOidc -> tennisService.identity.identityDb 'Realm data'

  // --- Moderation bot -> API Gateway ---
  tennisService.moderationBot -> tennisService.apiGateway 'Жалобы и снятие комментариев (/api/discussion/moderation/**)'

  // --- Client Apps -> API Gateway ---
  // Браузер в gateway не ходит: только в свой origin, дальше запрос собирает сервер Next.js.
  tennisService.webApp.publicSite -> tennisService.webApp.webServer 'Страницы; вход, сессия, комментарии и игнор через /api/**'
  tennisService.webApp.publicSite -> tennisService.userService.avatarStorage 'Фото читателей, напрямую из бакета'
  tennisService.webApp.publicSite -> tennisService.editorial.editorApp 'Ссылка «Редактировать» для сотрудников, в новой вкладке'
  tennisService.webApp.userCabinet -> tennisService.webApp.webServer 'Профиль, фото, ник, игнор-лист, удаление аккаунта'
  tennisService.webApp.webServer -> tennisService.apiGateway 'Прокси /api/discussion/**, /api/users/** с токеном из куки; статья — /api/public/articles/{slug} при рендере. Остальной контент — моки'
  tennisService.mobileApp.iosApp -> tennisService.apiGateway 'Контент (пока не подключено: работает на моках)'
  tennisService.mobileApp.androidApp -> tennisService.apiGateway 'Контент (пока не подключено: работает на моках)'
}

views {

  // ===== AS-IS =====

  view index of tennisService {
    title 'Контекст системы — как есть'
    description 'Что реально существует в репозитории'

    include *
    include reader
    include registeredUser
    include author
    include chiefEditor
    include moderator
    include admin
    include externalApis

    exclude element.tag = #planned
  }

  view containers of tennisService {
    title 'Контейнеры — как есть'

    include tennisService.*

    exclude element.tag = #planned
  }

  view editorialFlow {
    title 'Editorial Flow — как есть'
    description 'Автор и главный редактор → редакция и редактор → gateway → BFF / Content / Transcription; там же временно очередь модерации'

    include author
    include chiefEditor
    include moderator
    include tennisService.editorial
    include tennisService.editorial.*
    include tennisService.apiGateway
    include tennisService.editorialBff
    include tennisService.editorialBff.*
    include tennisService.contentService
    include tennisService.contentService.*
    include tennisService.transcriptionService
    include externalApis
    include externalApis.*

    exclude element.tag = #planned
  }

  view transcriptionFlow {
    title 'Transcription Flow'
    description 'Gateway → API → очередь → worker → хранилище. BFF в этом пути не участвует'

    include tennisService.apiGateway
    include tennisService.transcriptionService
    include tennisService.transcriptionService.*
    include externalApis.youtube
  }

  view readerFlow {
    title 'Reader Flow — как есть'
    description 'Читатель → сайт (BFF) → gateway → content / discussion / user. mobile пока на моках'

    include reader
    include registeredUser
    include tennisService.webApp
    include tennisService.webApp.*
    include tennisService.mobileApp
    include tennisService.mobileApp.*
    include tennisService.apiGateway
    include tennisService.contentService
    include tennisService.contentService.*
    include tennisService.discussionService
    include tennisService.discussionService.*
    include tennisService.userService
    include tennisService.userService.*

    exclude element.tag = #planned
  }

  // ===== TO-BE =====

  view indexTarget of tennisService {
    title 'Контекст системы — целевая'
    description 'Существующее плюс запланированное (бледным)'

    include *
    include reader
    include registeredUser
    include author
    include chiefEditor
    include admin
    include tennisDataSources
    include externalApis

    style element.tag = #planned {
      color gray
      opacity 30%
    }
  }

  view containersTarget of tennisService {
    title 'Контейнеры — целевая'

    include tennisService.*

    style element.tag = #planned {
      color gray
      opacity 30%
    }
  }

  view parsingFlow {
    title 'Parsing Flow — целевая'
    description 'Поток данных от источников до агрегатора. Не реализовано'

    include tennisDataSources
    include tennisDataSources.*
    include tennisService.parsingSubsystem
    include tennisService.parsingSubsystem.*
    include tennisService.aggregator
    include tennisService.aggregator.*
  }

  view authFlowTarget {
    title 'Auth Flow — целевая'
    description 'Клиенты получают токены у Identity Provider; gateway и сервисы валидируют их по JWKS. Роли и политика — auth.md. Не реализованы бот-модератор и вход в mobile'

    include registeredUser
    include author
    include chiefEditor
    include moderator
    include admin
    include tennisService.identity
    include tennisService.identity.*
    include tennisService.editorial
    include tennisService.webApp
    include tennisService.mobileApp
    include tennisService.moderationBot
    include tennisService.apiGateway
    include tennisService.contentService.contentApi
    include tennisService.editorialBff.editorialBffApi
    include tennisService.transcriptionService.transcriptionApi
    include tennisService.discussionService.discussionApi
    include tennisService.userService
    include tennisService.userService.*
  }
}
